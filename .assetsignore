# Files in the repo that should NOT be served from the public site.
# Uses gitignore syntax. Docs: https://developers.cloudflare.com/workers/static-assets/binding/#ignoring-assets

.git/
.wrangler/
.gitignore
.assetsignore
wrangler.jsonc
node_modules/
package.json
package-lock.json
*.md
.DS_Store
.vscode/
.idea/
# Template artefacts not used in this site
forms/
*.php
*.scss
assets/scss/
# Pipelines folder is portfolio source — not served
pipelines/
# wrangler runtime files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
